{
  "name": "nurses-notes",
  "description": "Notes Management for Travel Nurses",
  "version": "0.0.1",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "ng build && electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/electron": "^1.4.38",
    "electron-squirrel-startup": "^1.0.1",
    "puppeteer": "^25.17.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-msix": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "electron": "^45.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "net.willc-dev.nurses-notes",
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "nurses-notes"
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "background": "./assets/background.png",
            "format": "ULFO"
          }
        },
        {
          "name": "@electron-forge/maker-msix",
          "config": {
            "manifestVariables": {
              "publisher": "William Couture"
            },
            "windowSignOptions": {
              "certificateFile": "C:\\devcert.pfx",
              "certificatePassword": "122333444455555"
            }
          }
        }
      ]
    }
  }
}
