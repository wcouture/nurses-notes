{
  "name": "nurses-notes",
  "productName": "Nurses Notes",
  "description": "All-in-one time, travel, and notes management for nurses",
  "version": "1.1.0",
  "main": "main.js",
  "author": "William Couture",
  "scripts": {
    "build": "ng build",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/electron": "^1.4.38",
    "electron-squirrel-startup": "^1.0.1",
    "puppeteer": "^25.17.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "electron": "^45.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "net.willc-dev.nurses-notes",
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "arch": "x64",
        "icon": "./public/nurses-notes"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "loadingGif": "./assets/loading.gif",
            "name": "NursesNotes"
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "background": "./assets/background.jpg",
            "format": "ULFO"
          }
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "wcouture",
              "name": "nurses-notes"
            },
            "prerelease": false,
            "draft": false
          }
        }
      ]
    }
  }
}
